{
    "name": "wp-acga-tool",
    "version": "2.0.1-alpha.2",
    "description": "Assess Chinese Wikipedia animation, comics, games, and related articles with SuperGrey's ACGATool.",
    "private": true,
    "license": "MIT",
    "type": "module",
    "browser": "./src/app/browser.ts",
    "scripts": {
        "build": "node scripts/build.ts",
        "check": "npm run format:check && npm run lint && npm run check:types && npm run check:unused",
        "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
        "typecheck": "npm run check:types",
        "check:unused": "knip",
        "format": "prettier --write . \"!package-lock.json\"",
        "format:check": "prettier --check . \"!package-lock.json\"",
        "lint": "eslint . --max-warnings=0",
        "test": "node --import ./scripts/register-source-loaders.ts --test \"tests/**/*.test.ts\"",
        "test:ui": "npm run build && node scripts/test-ui.ts",
        "screenshots": "npm run build && DOCUMENTATION_SCREENSHOTS=1 node scripts/test-ui.ts --grep \"documentation screenshots\"",
        "verify": "npm run check && npm test && npm run test:ui"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "^1.62.1",
        "@types/node": "^24.19.0",
        "@vue/compiler-sfc": "^3.5.13",
        "@wikimedia/codex": "^2.6.0",
        "esbuild": "^0.28.0",
        "eslint": "10.11.0",
        "globals": "17.12.0",
        "knip": "6.38.0",
        "prettier": "3.9.9",
        "terser": "^5.48.0",
        "types-mediawiki": "^2.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.70.1",
        "vue": "3.5.13"
    },
    "engines": {
        "node": ">=24.14.1"
    },
    "prettier": {
        "tabWidth": 4,
        "overrides": [
            {
                "files": [
                    "*.md",
                    "*.yml",
                    "*.yaml"
                ],
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "knip": {
        "entry": [
            "src/index.ts!",
            "tests/**/*.test.ts",
            "scripts/*.ts",
            "src/types/**/*.d.ts!"
        ],
        "project": [
            "src/**/*.{ts,vue}!",
            "tests/**/*.ts",
            "scripts/*.ts"
        ]
    }
}
